
<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TableRow>
        <TextView
            android:text="@string/logowanie"
            android:textSize="24sp"
            android:background="#6200EE"
            android:textColor="#FFFFFF"
            android:padding="10dp" />
    </TableRow>

    <TableRow>
        <EditText
            android:id="@+id/login"
            android:autofillHints=""
            android:hint="@string/nazwa_u_ytkownika" android:inputType="TODO" />
    </TableRow>

    <TableRow>
        <EditText
            android:id="@+id/haslo"
            android:autofillHints="" android:hint="@string/podaj_has_o"
            android:inputType="textPassword" />
    </TableRow>

    <TableRow>
        <CheckBox
            android:id="@+id/zapamietaj"
            android:text="@string/zapami_taj" />
    </TableRow>

    <TableRow>
        <Button
            android:id="@+id/przycisk"
            android:text="@string/wy_wietl_informacje" />
    </TableRow>

</TableLayout>
